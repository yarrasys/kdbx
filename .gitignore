# never commit vault material
*.kdbx
*.keyx
*.key
.env
.env.*
# `kdbx export --out` takes an arbitrary path, and prod.env / secrets.env are the
# obvious names to reach for — .env.* alone does not cover them.
*.env
!.env.example

# build output
/dist/
/kdbx
/kdbx.exe

# Go test & coverage artifacts
*.test
*.out
coverage.txt

# knowledge graph cache
/graphify-out/

# OS & editor cruft
.DS_Store
*.swp
.idea/
.vscode/
